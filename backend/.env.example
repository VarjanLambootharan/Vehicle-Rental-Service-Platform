# Optional local overrides: the backend imports .env automatically when present.
APP_STORAGE_PATH=C:/path/to/Vehicle-Rental-Service-Platform/data/runtime
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<choose-a-strong-password-at-least-12-characters>
TOKEN_SECRET=<base64-encoded-random-key-at-least-32-bytes>
TOKEN_EXPIRATION=3600
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
SERVER_PORT=8080
APP_BUSINESS_TIMEZONE=Asia/Colombo
MOCK_PAYMENT_SUCCESS=true
